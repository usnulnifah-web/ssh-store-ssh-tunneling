[Unit]
Description=SSH Store VPS Provisioning Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/ssh-store-agent
EnvironmentFile=/etc/ssh-store-agent/agent.env
ExecStartPre=/usr/local/sbin/ssh-store-license-check
ExecStart=@NODE_BIN@ /opt/ssh-store-agent/agent.js
Restart=on-failure
RestartSec=5
User=root
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=off
 ProtectHome=no
ReadWritePaths=/var/lib/ssh-store-agent /home /etc

[Install]
WantedBy=multi-user.target
